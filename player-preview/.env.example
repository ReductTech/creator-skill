# Defaults to Shuku/ beside creator-skill/. Use forward slashes on Windows.
# Required for course previews when Shuku is installed elsewhere.
# SHUKU_ROOT=D:/Projects/Shuku

# Optional: defaults to creator-skill/target-root.json.
# This JSON must contain only targetRoot pointing to the course repository.
# CREATOR_SKILL_TARGET_CONFIG=D:/Courses/target-root.json
